{
  "name": "aranus-tech/chatbot",
  "description": "Plug-and-play Laravel chatbot package — Minara AI widget, Live Chat handover, and RAG Knowledge Base dashboard.",
  "keywords": ["laravel", "chatbot", "ai", "live-chat", "knowledge-base", "widget", "minara"],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Aranus Technology",
      "email": "admin@aranustech.co.id",
      "homepage": "https://aranustech.co.id"
    }
  ],
  "require": {
    "php": "^8.1",
    "illuminate/support": "^10.0|^11.0|^12.0",
    "illuminate/http": "^10.0|^11.0|^12.0",
    "illuminate/mail": "^10.0|^11.0|^12.0"
  },
  "require-dev": {
    "orchestra/testbench": "^7.0|^8.0|^9.0",
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "Aranus\\Chatbot\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Aranus\\Chatbot\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Aranus\\Chatbot\\ChatbotServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
